# Default Jellyfin server shown on the login screen
VITE_JELLYFIN_URL=https://jellyfin.example.com
# Optional: true pins the login to VITE_JELLYFIN_URL and hides the server field.
VITE_SERVER_LOCKED=false

# Optional: TMDB v3 API key (free at themoviedb.org) to show the real TMDB rating.
# Without it the rating stored in Jellyfin is shown instead. The key ends up in the client bundle.
VITE_TMDB_API_KEY=

# Optional: hide "Passwort ändern" on the profile page (for SSO/OIDC setups) and point users to the identity provider.
# VITE_ACCOUNT_URL is where the button leads; without it only an explanatory note is shown.
VITE_PASSWORD_CHANGE_DISABLED=false
# Put URLs containing a # in quotes, e.g. VITE_ACCOUNT_URL="https://auth.example.com/if/user/#/settings"
VITE_ACCOUNT_URL=

# Optional: Last.fm API key (free at last.fm/api, non-commercial use) for listener counts, popular tracks, similar
# artists and bios in Listen. Without it Listen shows what Jellyfin and this server know. The key ends up in the client bundle.
VITE_LASTFM_API_KEY=

# Optional: Ticketmaster Discovery API key (free at developer.ticketmaster.com) for upcoming concerts on artist pages.
# The Lumio server relays and caches the requests (also Last.fm's and MusicBrainz's); it can hold its own keys
# instead (TICKETMASTER_API_KEY, LASTFM_API_KEY).
# The key ends up in the client bundle.
VITE_TICKETMASTER_API_KEY=

# Optional: address of the Lumio server's API (server/ in this repository) when the app is served from somewhere else.
# Default: the same origin's /api (the server serves the app; in development Vite passes /api on to it).
VITE_SOCIAL_URL=
